// CogniPilot — Prisma schema
// Postgres 16. Generador del cliente JS y migraciones nativas Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Rol {
  admin_sistema
  supervisor
  gerente
  repartidor
}

enum AccionRegla {
  bloquear
  alertar
}

enum TipoRegla {
  paquete_fuera_parada       // HU-04 — bloqueo Poka-Yoke
  ventana_horaria            // HU-05 — fuera de horario de operación
  app_bloqueada_en_horario   // requerimiento extra — bloquear apps en horario laboral
}

enum TipoEvento {
  app_opened
  warning_shown
  scan_detected
  user_continued
  user_cancelled
  global_app_opened
  global_clicked
}

// ─────────────────────────────────────────────────────────────────────────────
// Empresa / Usuarios / Dispositivos
// ─────────────────────────────────────────────────────────────────────────────

model Empresa {
  id        String   @id @default(uuid())
  nombre    String   @unique
  cuit      String   @unique
  contacto  Json?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios Usuario[]
  rutas    Ruta[]
  reglas   Regla[]
}

model Usuario {
  id           String   @id @default(uuid())
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id])
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  dispositivos   Dispositivo[]
  asignaciones   Asignacion[]
  eventos        EventoApp[]
  incidentes     Incidente[]
  posiciones     Posicion[]
  reglasHist     ReglaHistorial[]

  @@index([empresaId])
}

model Dispositivo {
  id         String   @id @default(uuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  deviceUuid String   @unique
  fcmToken   String?
  modelo     String?
  osVersion  String?
  appVersion String?
  activo     Boolean  @default(true)
  // Posición denormalizada para queries rápidas del mapa
  lastLat    Decimal? @db.Decimal(9, 6)
  lastLng    Decimal? @db.Decimal(9, 6)
  lastSeen   DateTime @default(now())
  createdAt  DateTime @default(now())

  eventos    EventoApp[]
  incidentes Incidente[]
  posiciones Posicion[]

  @@index([usuarioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Operación: rutas / paradas / paquetes / asignaciones
// ─────────────────────────────────────────────────────────────────────────────

model Ruta {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nombre    String
  fecha     DateTime @db.Date

  paradas      Parada[]
  reglas       Regla[]
  asignaciones Asignacion[]

  @@index([empresaId, fecha])
}

model Parada {
  id           String  @id @default(uuid())
  rutaId       String
  ruta         Ruta    @relation(fields: [rutaId], references: [id])
  orden        Int
  lat          Decimal @db.Decimal(9, 6)
  lng          Decimal @db.Decimal(9, 6)
  direccion    String?
  ventanaDesde String? // "HH:mm"
  ventanaHasta String?

  paquetes Paquete[]
}

model Paquete {
  id          String  @id @default(uuid())
  paradaId    String
  parada      Parada  @relation(fields: [paradaId], references: [id])
  codigoMl    String
  descripcion String?

  incidentes Incidente[]

  @@index([codigoMl])
}

model Asignacion {
  id           String   @id @default(uuid())
  repartidorId String
  repartidor   Usuario  @relation(fields: [repartidorId], references: [id])
  rutaId       String
  ruta         Ruta     @relation(fields: [rutaId], references: [id])
  fecha        DateTime @db.Date

  @@unique([repartidorId, fecha])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reglas
// ─────────────────────────────────────────────────────────────────────────────

model Regla {
  id        String      @id @default(uuid())
  empresaId String
  empresa   Empresa     @relation(fields: [empresaId], references: [id])
  rutaId    String?
  ruta      Ruta?       @relation(fields: [rutaId], references: [id])
  nombre    String
  tipo      TipoRegla
  accion    AccionRegla
  condicion Json
  activa    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  historial ReglaHistorial[]

  @@index([empresaId, activa])
}

model ReglaHistorial {
  id        String   @id @default(uuid())
  reglaId   String
  regla     Regla    @relation(fields: [reglaId], references: [id])
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  ts        DateTime @default(now())
  campo     String
  valorOld  Json?
  valorNew  Json?

  @@index([reglaId, ts])
}

// ─────────────────────────────────────────────────────────────────────────────
// Eventos / Incidentes / Posiciones
// ─────────────────────────────────────────────────────────────────────────────

model EventoApp {
  id            String       @id @default(uuid())
  tipo          TipoEvento
  ts            DateTime     @default(now())
  usuarioId     String?
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id])
  dispositivoId String?
  dispositivo   Dispositivo? @relation(fields: [dispositivoId], references: [id])
  inSchedule    Boolean?
  screenName    String?
  appPackage    String?
  keywords      String[]
  screenText    String[]

  @@index([ts])
  @@index([dispositivoId, ts])
}

model Incidente {
  id            String      @id @default(uuid())
  repartidorId  String
  repartidor    Usuario     @relation(fields: [repartidorId], references: [id])
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id])
  reglaId       String?
  paqueteId     String?
  paquete       Paquete?    @relation(fields: [paqueteId], references: [id])
  ts            DateTime    @default(now())
  lat           Decimal?    @db.Decimal(9, 6)
  lng           Decimal?    @db.Decimal(9, 6)
  datos         Json?

  @@index([repartidorId, ts])
}

model Posicion {
  id            String      @id @default(uuid())
  repartidorId  String
  repartidor    Usuario     @relation(fields: [repartidorId], references: [id])
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id])
  ts            DateTime    @default(now())
  lat           Decimal     @db.Decimal(9, 6)
  lng           Decimal     @db.Decimal(9, 6)

  @@index([repartidorId, ts])
}
