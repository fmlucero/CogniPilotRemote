# CogniPilot — env vars
# Copiar a .env y completar. .env NO se commitea.

# Postgres
POSTGRES_PASSWORD=cambiar-en-vm

# DB URL para Prisma local (dev en Windows apuntando a la VM)
# Cuando corre dentro del compose, app usa 'postgres' como host.
DATABASE_URL=postgresql://cognipilot:cambiar-en-vm@10.201.0.67:5432/cognipilot?schema=public

# JWT — generar con: openssl rand -hex 32
JWT_SECRET=cambiar-32-bytes-hex
JWT_REFRESH_SECRET=cambiar-32-bytes-hex-distinto

# Firebase Admin (FCM push) — JSON completo del service account en una línea
FIREBASE_SERVICE_ACCOUNT_JSON=

# pgAdmin
PGADMIN_EMAIL=admin@cognipilot.local
PGADMIN_PASSWORD=cambiar

# Seed — passwords iniciales de los usuarios precargados (mínimo 8 chars).
# Solo se usan al correr `npm run prisma:seed`. Cambiar en producción.
SEED_ADMIN_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_GERENTE_PASSWORD=
SEED_REPARTIDOR_PASSWORD=
