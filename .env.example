# CogniPilot Front — env vars
# Copiar a .env y completar. .env NO se commitea.
#
# Post HU-18: el front es SOLO UI. No tiene DB ni FCM ni endpoints API
# (los borramos en el cleanup). Solo necesita:
#   - JWT_SECRET para validar la cookie cp_at en Server Components
#   - BACK_API_URL para que serverFetch alcance al FastAPI back
#
# El back FastAPI vive en cognipilot-back (otro repo) y corre en :8001 en la VM.

# ──────────────────────────────────────────────────────────────────────────────
# JWT — MISMO secret que cognipilot-back (firmado allá, verificado acá)
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar-32-bytes-hex

# ──────────────────────────────────────────────────────────────────────────────
# URL del back FastAPI (Server Components hacen fetch a este endpoint)
# ──────────────────────────────────────────────────────────────────────────────
# En la VM, modo paralelo: el container del front llega al back via host gateway
BACK_API_URL=http://host.docker.internal:8001
# En dev local apuntando a la VM via ZeroTier:
# BACK_API_URL=http://10.201.0.67:8001

# ──────────────────────────────────────────────────────────────────────────────
# Postgres — solo si seguís corriendo el container postgres en este compose
# (el back FastAPI también lo usa). Si lo movés al compose del back, sacar.
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=cambiar-en-vm

# pgAdmin (opcional)
PGADMIN_EMAIL=admin@cognipilot.local
PGADMIN_PASSWORD=cambiar
